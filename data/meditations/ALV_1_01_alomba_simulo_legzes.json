    "blocks": [
      {
        "type": "text",
        "content": "Helyezkedj el kényelmesen...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Engedd, hogy körülötted lassan halkabbá váljon a világ...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Érezd, ahogy a tested súlyával belesüllyed az ágyba...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Semmit sem kell tenned...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 2500
      },
      {
        "type": "text",
        "content": "Semmit sem kell akarnod.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Csak figyeld meg egy pillanatra a légzésed...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "A légzésed lassan, magától lecsendesedik...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Most lélegezz be lassan..",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3500
      },
      {
        "type": "text",
        "content": "Érezd, ahogy a csend megtelik levegővel...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Majd engedd ki lassan...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "És pihenj meg egy pillanatra...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Az üresség csendjében.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "Most figyeld meg, mit érzel a testedben...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "Érezd a fejed súlyát...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Mint egy kavics, amely megpihen a folyó fenekén.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "A homlok ellazul...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "A szemek puhán megpihennek...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Az állkapocs elernyed... mint egy levél, amely lassan megpihen a vízen.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "Minden kilégzéssel egyre mélyebbre süllyedsz...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Az ágyad puha ölelésébe.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Érzed a vállaidat...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "A karok elnehezülnek...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "A kezek megpihennek, mintha egy tiszta tó partján heverésznének.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 6000
      },
      {
        "type": "text",
        "content": "A mellkasod és a hasad lágyan hullámzik a légzéssel...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Semmit sem kell irányítani...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Csak hagyd, hogy a légzésed lágy hulláma tovább ringasson...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Vidd a figyelmed a lábaidra...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "A combok, térdek, lábszárak, majd a lábfejek mind ellazulnak...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Mintha egy meleg áramlat simítaná őket.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 8000
      },
      {
        "type": "text",
        "content": "A tested átjárja a puhaság...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Engedd, hogy feloldódjon a láthatatlan csend ölelésében.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 10000
      },
      {
        "type": "text",
        "content": "Nem kell tartanod semmit...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Nem kell figyelned semmit...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Csak engedd, hogy légy...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "És légy önmagad nyugalmában.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 8000
      },
      {
        "type": "text",
        "content": "Most hagyd, hogy a tested súlyánál fogva...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "még mélyebbre süllyedjen a nyugalom térébe.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 12000
      },
      {
        "type": "text",
        "content": "Ha gondolat érkezik, figyeld meg...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Majd engedd tovább, mintha felhőt sodorna a szél.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 7000
      },
      {
        "type": "text",
        "content": "Nem kell követned...",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "Csak engedd, hogy minden önmaga legyen.",
        "tone": "neutral"
      },
      {
        "type": "pause",
        "duration_ms": 8000
      },
      {
        "type": "text",
        "content": "",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 2000
      },
      {
        "type": "text",
        "content": "Most már nincsen út...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Nincsen cél...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 3000
      },
      {
        "type": "text",
        "content": "Csak a létezés puha ringása...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 25000
      },
      {
        "type": "text",
        "content": "És amikor kész vagy...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 4000
      },
      {
        "type": "text",
        "content": "Átadhatod magad a csendnek, a pihenésnek...",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 5000
      },
      {
        "type": "text",
        "content": "És az édes, mély alvásnak.",
        "tone": "soft"
      },
      {
        "type": "pause",
        "duration_ms": 35000
      }
    ]
  },
