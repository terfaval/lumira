        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1:obs1_2",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1",
        "sceneStableId": "scene1",
        "observationStableId": "obs1_2",
        "position": 2,
        "text": "Eleinte bosszankodom a szobákon, amelyekben elszállásoltak, később megértem az okát.",
        "category": "other",
        "evidence": [
          {
            "snippet": "eleinte azon bosszankodom, hogy miért ezekbe a szobákba lettünk elszállásolva, aztán valahogy megértem, hogy így volt olcsóbb.",
            "spanStart": 80,
            "spanEnd": 143
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1:obs1_3",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1",
        "sceneStableId": "scene1",
        "observationStableId": "obs1_3",
        "position": 3,
        "text": "A szállás előtti mezőn találkozom Bórával, az általános iskolából ismert crushommal.",
        "category": "other",
        "evidence": [
          {
            "snippet": "lemegyek a szállás előtti mezőre és az első nagy crushommal találkozom, Bórával az általános iskolából.",
            "spanStart": 144,
            "spanEnd": 203
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1:obs1_4",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1",
        "sceneStableId": "scene1",
        "observationStableId": "obs1_4",
        "position": 4,
        "text": "Froclizom Bórát, hogy eldugtam a telefonját, de nem árulom el a helyét.",
        "category": "other",
        "evidence": [
          {
            "snippet": "valamiért azzal froclizom, hogy eldugtam a telefonját - legalábbis valamiért rajtam keresi azt, én meg tudom, hogy hol van, de nem árulom el.",
            "spanStart": 204,
            "spanEnd": 261
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1:obs1_5",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1",
        "sceneStableId": "scene1",
        "observationStableId": "obs1_5",
        "position": 5,
        "text": "A saját telefonomat magasra dobálgatom, aggódom a sérülés miatt, de folytatom.",
        "category": "other",
        "evidence": [
          {
            "snippet": "hogy bosszantsam a saját telefonomat dobálgatom fel jó magasra. kicsit aggódom, hogy össze fog törni vagy bármi baja lesz, de csak azért is dobálgatom.",
            "spanStart": 262,
            "spanEnd": 327
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1:obs1_6",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1",
        "sceneStableId": "scene1",
        "observationStableId": "obs1_6",
        "position": 6,
        "text": "A telefon többször leesik, de folytatom a dobálást, Bóra egyre idegesebb.",
        "category": "other",
        "evidence": [
          {
            "snippet": "pocsolyába esik, száraz talajra esik, mindegy folytatom. már 4-5 alkalommal dobtam azt hiszem, és Bóra egyre idegesebb...",
            "spanStart": 328,
            "spanEnd": 382
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1:obs1_7",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene1",
        "sceneStableId": "scene1",
        "observationStableId": "obs1_7",
        "position": 7,
        "text": "Megmondom Bórának a telefon helyét, de közben kiderül, hogy én sem tudom, így segítek keresni.",
        "category": "other",
        "evidence": [
          {
            "snippet": "még egyszer feldobom, majd megmondom neki, hogy hol van. közben azonban kiderül, hogy igazából én se tudom, hogy hol van, úgyhogy segítek neki megkeresni.",
            "spanStart": 383,
            "spanEnd": 459
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2:obs2_1",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2",
        "sceneStableId": "scene2",
        "observationStableId": "obs2_1",
        "position": 1,
        "text": "Visszaérkezünk az épületekhez, ahol verandás sorház található a mező szélén fák alatt.",
        "category": "other",
        "evidence": [
          {
            "snippet": "visszaérünk az épületekhez. a szállás és a közösségi terek egy verandás sorházban vannak a nagy mező szélén a fák alatt.",
            "spanStart": 460,
            "spanEnd": 517
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2:obs2_2",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2",
        "sceneStableId": "scene2",
        "observationStableId": "obs2_2",
        "position": 2,
        "text": "Belépek a konyhába/étkezőbe, Bóra eltűnt és idősebbnek érzem magam.",
        "category": "other",
        "evidence": [
          {
            "snippet": "a konyhába/étkezőbe lépek, Bóra eltűnt és én hirtelen idősebb lettem valamivel.",
            "spanStart": 518,
            "spanEnd": 563
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2:obs2_3",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2",
        "sceneStableId": "scene2",
        "observationStableId": "obs2_3",
        "position": 3,
        "text": "Apám és Kata főznek, az asztalnál többen ülnek, jó hangulat van.",
        "category": "other",
        "evidence": [
          {
            "snippet": "van egy kisebb konyha, amiben apám és Kata, a mostohaanyám főznek, illetve egy kisebb asztal, ami körül többen ülnek, mint ahányan kényelmesen el lehet férni, de jó hangulat van.",
            "spanStart": 564,
            "spanEnd": 628
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2:obs2_4",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2",
        "sceneStableId": "scene2",
        "observationStableId": "obs2_4",
        "position": 4,
        "text": "Apám receptet pitchel: túrós, sajtos, zöldséges étel, dramatizált belépés.",
        "category": "other",
        "evidence": [
          {
            "snippet": "amikor belépek, akkor apám épp egy receptet pitchel. valami túrós, sajtos, zöldséges.. nem is tudom mit, csak azért emlékszem, mert úgy lépek be a szobába, hogy ezeket ismételem úgy dramatizálva...",
            "spanStart": 629,
            "spanEnd": 695
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2:obs2_5",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2",
        "sceneStableId": "scene2",
        "observationStableId": "obs2_5",
        "position": 5,
        "text": "Dohányzás közben lehamuzom Markus fehér vászonnadrágját, bocsánatot kérek, letörlöm, Kata segíteni akar.",
        "category": "other",
        "evidence": [
          {
            "snippet": "majd egyszer csak dohányzás közben lehamuzom Markus fehér vászonnadrágját. sűrűn bocsánatot kérek, és letörölgetem... Kata egyszercsak azt mondja, hogy citrommal ki lehet szedni... Kata segíteni akar... el is mennek ketten.",
            "spanStart": 696,
            "spanEnd": 786
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2:obs2_6",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2",
        "sceneStableId": "scene2",
        "observationStableId": "obs2_6",
        "position": 6,
        "text": "Rossz érzésem van emiatt, apám megnyugtat, hogy mindenkivel megesik.",
        "category": "other",
        "evidence": [
          {
            "snippet": "én rosszul érzem magam, de apám megnyugtat, hogy nem történt semmi baj és mindenkivel megesik.",
            "spanStart": 787,
            "spanEnd": 833
          }
        ],
        "uncertaintyNote": null
      },
      {
        "observationV2SceneObservationId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2:obs2_7",
        "sceneRowId": "observation-bundle-ae7fd730-eb19-43d6-9781-20e042fc5d9c-observation_v2_phase1:scene2",
        "sceneStableId": "scene2",
        "observationStableId": "obs2_7",
        "position": 7,
        "text": "Évi figyelmét érzem magamon folyamatosan, bár őt nem látom vagy alig emlékszem rá.",
        "category": "other",
        "evidence": [
          {
            "snippet": "Évire csak úgy emlékszem, mint akinek érzem a figyelmét magamon folyamatosan - őt magát egyébként nem láttam, vagy legalábbis nem emlékszem rá, talán csak egy pillanatra, de a jelenlétét és figyelmét egyértelműen érzékeltem a dohányzós epizód óta.",
            "spanStart": 834,
            "spanEnd": 874
          }
        ],
